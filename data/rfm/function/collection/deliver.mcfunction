#藏品不会因显示物丢失而失效；计分板持有状态才是效果真值
clear @s minecraft:amethyst_shard[minecraft:custom_data~{rfm_collection:1}]
execute if score @s collection_slot1 matches 1 run item replace entity @s hotbar.0 with minecraft:amethyst_shard[minecraft:custom_name='{"text":"褪色的记者证","color":"aqua","bold":true,"italic":false}',minecraft:lore=['{"text":"属性公示后，若没有任何一项领先","color":"gray","italic":false}','{"text":"名誉 +3","color":"aqua","italic":false}','{"text":"持续生效；相同藏品只生效一次","color":"yellow","italic":false}'],minecraft:custom_model_data=700101,minecraft:custom_data={rfm_collection:1,collection_id:1,collection_slot:1}] 1
execute if score @s collection_slot1 matches 2 run item replace entity @s hotbar.0 with minecraft:amethyst_shard[minecraft:custom_name='{"text":"无名英雄勋章","color":"gold","bold":true,"italic":false}',minecraft:lore=['{"text":"若本回合没有成为行动玩家","color":"gray","italic":false}','{"text":"属性公示前四项属性各 +1","color":"white","italic":false}','{"text":"持续生效；相同藏品只生效一次","color":"yellow","italic":false}'],minecraft:custom_model_data=700102,minecraft:custom_data={rfm_collection:1,collection_id:2,collection_slot:1}] 1
execute if score @s collection_slot1 matches 3 run item replace entity @s hotbar.0 with minecraft:amethyst_shard[minecraft:custom_name='{"text":"金属怀表","color":"yellow","bold":true,"italic":false}',minecraft:lore=['{"text":"回合结束时，将经济与最低属性互换","color":"gray","italic":false}','{"text":"并列最低时随机选择；经济最低时不交换","color":"yellow","italic":false}','{"text":"持续生效；相同藏品只生效一次","color":"gold","italic":false}'],minecraft:custom_model_data=700103,minecraft:custom_data={rfm_collection:1,collection_id:3,collection_slot:1}] 1
execute if score @s collection_slot1 matches 4 run item replace entity @s hotbar.0 with minecraft:amethyst_shard[minecraft:custom_name='{"text":"带批注的档案","color":"green","bold":true,"italic":false}',minecraft:lore=['{"text":"完成决策任务后，增加最多的属性额外 +2","color":"gray","italic":false}','{"text":"并列时随机选择其中一项","color":"yellow","italic":false}','{"text":"持续生效；相同藏品只生效一次","color":"gold","italic":false}'],minecraft:custom_model_data=700104,minecraft:custom_data={rfm_collection:1,collection_id:4,collection_slot:1}] 1
execute if score @s collection_slot1 matches 5 run item replace entity @s hotbar.0 with minecraft:amethyst_shard[minecraft:custom_name='{"text":"诉讼卷宗","color":"light_purple","bold":true,"italic":false}',minecraft:lore=['{"text":"每使用一次令牌，所有属性 +5","color":"gray","italic":false}','{"text":"持续生效；相同藏品只生效一次","color":"gold","italic":false}'],minecraft:custom_model_data=700105,minecraft:custom_data={rfm_collection:1,collection_id:5,collection_slot:1}] 1
execute if score @s collection_slot1 matches 6 run item replace entity @s hotbar.0 with minecraft:amethyst_shard[minecraft:custom_name='{"text":"老旧的战功章","color":"#FFA500","bold":true,"italic":false}',minecraft:lore=['{"text":"完美完成行动任务时，最低属性 +5","color":"gray","italic":false}','{"text":"并列最低属性会同时增加","color":"yellow","italic":false}','{"text":"持续生效；相同藏品只生效一次","color":"gold","italic":false}'],minecraft:custom_model_data=700106,minecraft:custom_data={rfm_collection:1,collection_id:6,collection_slot:1}] 1

