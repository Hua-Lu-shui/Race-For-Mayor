function rfm:collection/mysterious/configure_offer
scoreboard players operation @s collection_view_round = #round round
playsound minecraft:entity.villager.ambient master @s ~ ~ ~ 0.7 0.8
tellraw @s [{"text":"神秘人：","color":"dark_purple","bold":true},{"text":"我为你准备了一件只属于你的藏品。","color":"white"}]
execute if score @s collection_offer matches 1 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"褪色的记者证","color":"green","bold":true},{"text":"\n稀有度：普通","color":"green"},{"text":"\n持续效果：每回合属性公示后，若你没有任何一项领先，名誉 +4。","color":"white"}]
execute if score @s collection_offer matches 2 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"羽毛笔","color":"green","bold":true},{"text":"\n稀有度：普通","color":"green"},{"text":"\n持续效果：若本回合没有成为行动玩家，属性公示前四项属性各 +1。","color":"white"}]
execute if score @s collection_offer matches 3 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"金属怀表","color":"blue","bold":true},{"text":"\n稀有度：稀有","color":"blue"},{"text":"\n持续效果：每回合结束时，将经济与最低属性互换。","color":"white"}]
execute if score @s collection_offer matches 4 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"带批注的档案","color":"green","bold":true},{"text":"\n稀有度：普通","color":"green"},{"text":"\n持续效果：每次完成决策任务后，该任务中增加最多的属性额外 +2；并列时随机选择其中一项。","color":"white"}]
execute if score @s collection_offer matches 5 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"诉讼卷宗","color":"green","bold":true},{"text":"\n稀有度：普通","color":"green"},{"text":"\n持续效果：每使用一次令牌，所有属性 +5。","color":"white"}]
execute if score @s collection_offer matches 6 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"老旧的战功章","color":"green","bold":true},{"text":"\n稀有度：普通","color":"green"},{"text":"\n持续效果：完美完成行动任务时，最低属性 +5；并列最低时随机选择其中一项。","color":"white"}]
execute if score @s collection_offer matches 7 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"水晶球","color":"light_purple","bold":true},{"text":"\n稀有度：史诗","color":"light_purple"},{"text":"\n持续效果：回合开始时，最高权重对应的属性 +3；并列时随机选择其中一项。","color":"white"}]
execute if score @s collection_offer matches 8 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"银戒指","color":"green","bold":true},{"text":"\n稀有度：普通","color":"green"},{"text":"\n无单独效果；同时拥有银戒指和金戒指时，每回合结束时所有属性 +4。","color":"white"}]
execute if score @s collection_offer matches 9 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"金戒指","color":"blue","bold":true},{"text":"\n稀有度：稀有","color":"blue"},{"text":"\n无单独效果；同时拥有银戒指和金戒指时，每回合结束时所有属性 +4。","color":"white"}]
execute if score @s collection_offer matches 10 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"神秘的斗篷","color":"light_purple","bold":true},{"text":"\n稀有度：史诗","color":"light_purple"},{"text":"\n持续效果：免疫其他候选人的属性互换与属性专精影响。","color":"white"}]
execute if score @s collection_offer matches 11 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"琥珀","color":"light_purple","bold":true},{"text":"\n稀有度：史诗","color":"light_purple"},{"text":"\n持续效果：购买或获得时记录当前所有属性，并在最终结算时给予。","color":"white"}]
execute if score @s collection_offer matches 12 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"魔镜","color":"light_purple","bold":true},{"text":"\n稀有度：史诗","color":"light_purple"},{"text":"\n持续效果：每有一位其他同身份候选人，决策任务对你的属性影响翻一倍。","color":"white"}]
execute if score @s collection_offer matches 13 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"做工精美的手镯","color":"blue","bold":true},{"text":"\n稀有度：稀有","color":"blue"},{"text":"\n持续效果：每进行一次决策任务，所有属性 +2。","color":"white"}]
execute if score @s collection_offer matches 14 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"珠宝大盗的手套","color":"light_purple","bold":true},{"text":"\n稀有度：史诗","color":"light_purple"},{"text":"\n持续效果：每回合有 50% 几率偷取一件其他候选人身上且自己未拥有的藏品；需要有空槽。","color":"white"}]
execute if score @s collection_offer matches 15 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"历史悠久的花瓶","color":"blue","bold":true},{"text":"\n稀有度：稀有","color":"blue"},{"text":"\n持续效果：每回合开始时，当前最高属性 +5；并列时随机选择其中一项。","color":"white"}]
execute if score @s collection_offer matches 16 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"护目镜","color":"green","bold":true},{"text":"\n稀有度：普通","color":"green"},{"text":"\n持续效果：回合开始时，生态 +2。","color":"white"}]
execute if score @s collection_offer matches 17 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"不知名种子","color":"blue","bold":true},{"text":"\n稀有度：稀有","color":"blue"},{"text":"\n持续效果：回合开始时，生态 +3。","color":"white"}]
execute if score @s collection_offer matches 18 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"玩具熊","color":"green","bold":true},{"text":"\n稀有度：普通","color":"green"},{"text":"\n持续效果：回合开始时，民生 +2。","color":"white"}]
execute if score @s collection_offer matches 19 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"礼品盒","color":"blue","bold":true},{"text":"\n稀有度：稀有","color":"blue"},{"text":"\n持续效果：回合开始时，民生 +3。","color":"white"}]
execute if score @s collection_offer matches 20 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"招财猫","color":"green","bold":true},{"text":"\n稀有度：普通","color":"green"},{"text":"\n持续效果：回合开始时，经济 +2。","color":"white"}]
execute if score @s collection_offer matches 21 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"摇钱树","color":"blue","bold":true},{"text":"\n稀有度：稀有","color":"blue"},{"text":"\n持续效果：回合开始时，经济 +3。","color":"white"}]
execute if score @s collection_offer matches 22 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"华丽的面具","color":"green","bold":true},{"text":"\n稀有度：普通","color":"green"},{"text":"\n持续效果：回合开始时，名誉 +2。","color":"white"}]
execute if score @s collection_offer matches 23 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"礼服","color":"blue","bold":true},{"text":"\n稀有度：稀有","color":"blue"},{"text":"\n持续效果：回合开始时，名誉 +3。","color":"white"}]
execute if score @s collection_offer matches 24 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"手枪子弹","color":"blue","bold":true},{"text":"\n稀有度：稀有","color":"blue"},{"text":"\n持续效果：回合开始时，每拥有一件藏品，最低属性 +2。","color":"white"}]
execute if score @s collection_offer matches 25 run tellraw @s [{"text":"本次藏品：","color":"gray"},{"text":"无人认领的钥匙","color":"light_purple","bold":true},{"text":"\n稀有度：史诗","color":"light_purple"},{"text":"\n持续效果：每回合开始时，有 20% 几率使最低属性翻倍。","color":"white"}]
execute if score @s collection_trade_round = #round round run tellraw @s {"text":"你本回合已经刷新过一次报价，请等待下一回合刷新报价。","color":"gray"}
execute unless score @s collection_trade_round = #round round if score @s collection_cost matches ..-1 run tellraw @s {"text":"交易所需属性与价格尚未确定，当前无法交易。","color":"gray"}
execute unless score @s collection_trade_round = #round round if score @s collection_attr matches 1..8 run scoreboard players enable @s collection_confirm
execute unless score @s collection_trade_round = #round round if score @s collection_attr matches 1 run tellraw @s [{"text":"交易价格：名誉 -","color":"gray"},{"score":{"name":"@s","objective":"collection_cost"},"color":"aqua","bold":true},{"text":" [确认交易]","color":"green","bold":true,"clickEvent":{"action":"run_command","value":"/trigger collection_confirm set 1"}}]
execute unless score @s collection_trade_round = #round round if score @s collection_attr matches 2 run tellraw @s [{"text":"交易价格：经济 -","color":"gray"},{"score":{"name":"@s","objective":"collection_cost"},"color":"yellow","bold":true},{"text":" [确认交易]","color":"green","bold":true,"clickEvent":{"action":"run_command","value":"/trigger collection_confirm set 1"}}]
execute unless score @s collection_trade_round = #round round if score @s collection_attr matches 3 run tellraw @s [{"text":"交易价格：民生 -","color":"gray"},{"score":{"name":"@s","objective":"collection_cost"},"color":"red","bold":true},{"text":" [确认交易]","color":"green","bold":true,"clickEvent":{"action":"run_command","value":"/trigger collection_confirm set 1"}}]
execute unless score @s collection_trade_round = #round round if score @s collection_attr matches 4 run tellraw @s [{"text":"交易价格：生态 -","color":"gray"},{"score":{"name":"@s","objective":"collection_cost"},"color":"green","bold":true},{"text":" [确认交易]","color":"green","bold":true,"clickEvent":{"action":"run_command","value":"/trigger collection_confirm set 1"}}]
execute unless score @s collection_trade_round = #round round if score @s collection_attr matches 5 run tellraw @s [{"text":"交易价格：当前最高属性 -","color":"gray"},{"score":{"name":"@s","objective":"collection_cost"},"color":"gold","bold":true},{"text":"\n若多项属性并列最高，将随机扣除其中一项。","color":"dark_gray"},{"text":" [确认交易]","color":"green","bold":true,"clickEvent":{"action":"run_command","value":"/trigger collection_confirm set 1"}}]
execute unless score @s collection_trade_round = #round round if score @s collection_attr matches 6 run tellraw @s [{"text":"交易价格：所有属性 -","color":"gray"},{"score":{"name":"@s","objective":"collection_cost"},"color":"white","bold":true},{"text":" [确认交易]","color":"green","bold":true,"clickEvent":{"action":"run_command","value":"/trigger collection_confirm set 1"}}]
execute unless score @s collection_trade_round = #round round if score @s collection_attr matches 7 run tellraw @s [{"text":"交易价格：当前最高属性与最低属性 -","color":"gray"},{"score":{"name":"@s","objective":"collection_cost"},"color":"gold","bold":true},{"text":"\n并列时分别随机扣除其中一项。","color":"dark_gray"},{"text":" [确认交易]","color":"green","bold":true,"clickEvent":{"action":"run_command","value":"/trigger collection_confirm set 1"}}]
execute unless score @s collection_trade_round = #round round if score @s collection_attr matches 8 run tellraw @s [{"text":"交易价格：当前最低属性 -","color":"gray"},{"score":{"name":"@s","objective":"collection_cost"},"color":"gold","bold":true},{"text":"\n若多项属性并列最低，将随机扣除其中一项。","color":"dark_gray"},{"text":" [确认交易]","color":"green","bold":true,"clickEvent":{"action":"run_command","value":"/trigger collection_confirm set 1"}}]
